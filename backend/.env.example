# Copy to .env. Never commit the real .env file.
APP_ENV=production
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-at-least-32-random-bytes
FRONTEND_ORIGINS=https://your-exact-frontend-origin.example
SESSION_COOKIE_SECURE=true
# Use Lax for same-site deployments; use None only for cross-site frontend/API origins (HTTPS required).
SESSION_COOKIE_SAMESITE=Lax
DATABASE_PATH=/var/lib/rlems/recharge_manager.db
DATABASE_LOCK_TIMEOUT_SECONDS=60
# Set only when traffic comes through this many trusted reverse proxies.
TRUSTED_PROXY_HOPS=0
# Production must use shared Redis storage; keep the real Redis URL in the host secret manager.
RATELIMIT_STORAGE_URI=rediss://user:replace-me@redis-host:6380/0

# Used only to create the first admin when the users table is empty.
# Use a unique username and a randomly generated password with 16+ characters.
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
